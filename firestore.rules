/*
  firestore.rules — AppRotina

  Crença 1: autenticação nunca tem default. A resposta do Felipe em
  2026-09-17 foi login com Google E com e-mail/senha, os dois.

  UM ESPAÇO POR PESSOA (2026-09-18). Cada conta mora em
  `usuarios/{email}/...` e só enxerga o que está debaixo do próprio e-mail.
  O caminho É a permissão: não existe campo `dono` pra alguém forjar numa
  gravação, e nenhuma consulta pode "escapar" pro espaço do outro, porque
  ela nem tem como nomear esse caminho.

  AUTORIZAÇÃO POR E-MAIL, NÃO POR uid. Se fosse por uid, o login Google
  geraria um uid e o login por senha geraria outro, e a mesma pessoa veria
  duas listas diferentes dependendo de como entrou. Por e-mail, os dois
  caminhos caem no mesmo espaço.

  CADASTRO ABERTO, PORTA NO E-MAIL CONFIRMADO (2026-09-18). Não existe mais
  lista de autorizados: qualquer pessoa cria conta e ganha o próprio espaço.
  O que substitui a lista é `email_verified`, e ele não é enfeite — como o
  espaço é endereçado pelo e-mail, sem essa exigência alguém se cadastraria
  por senha com um e-mail que não é dele e ocuparia aquele espaço. Quem
  entra pelo Google já vem confirmado.

  A regra vale aqui mesmo com a tela do app também checando: tela é
  conveniência, regra é a fechadura (crença 1).

  hasOnly() em toda coleção fecha mass assignment: sem ele, uma escrita
  poderia enfiar campo não previsto aqui.
*/

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* dono do espaço: logado, e-mail confirmado, e o e-mail do token é
       exatamente o do caminho que ele está tentando ler ou escrever */
    function dono(email) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
    }

    function texto(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }
    function textoCheio(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }
    // "YYYY-MM-DD"
    function dataISO(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // "HH:MM"
    function horaHM(v) {
      return v is string && v.matches('^[0-9]{2}:[0-9]{2}$');
    }

    match /usuarios/{email} {
      // o documento do usuário em si não guarda nada; o conteúdo vive nas
      // subcoleções abaixo
      allow read: if dono(email);

      match /categorias/{id} {
        allow read: if dono(email);
        allow create, update: if dono(email)
          && request.resource.data.keys().hasOnly(['nome','cor','ordem','ativa','createdAt'])
          && textoCheio(request.resource.data.nome, 40)
          && texto(request.resource.data.cor, 9)
          && request.resource.data.ativa is bool;
        allow delete: if dono(email);
      }

      match /rotinas/{id} {
        allow read: if dono(email);
        allow create, update: if dono(email)
          && request.resource.data.keys().hasOnly([
               'nome','hora','duracaoMin','ativa','diasSemana','categoriaId','atividades',
               'agendaEventoId','agendaHash','createdAt'
             ])
          && textoCheio(request.resource.data.nome, 80)
          && horaHM(request.resource.data.hora)
          /*
            A rotina sempre tem categoria própria: sem atividade cadastrada,
            ela é a própria atividade (decisão de 2026-09-18).

            Mesmo assim o campo é ACEITO AUSENTE de propósito, porque rotina
            criada antes dessa decisão não o tem, e exigir aqui faria TODA
            gravação nessas rotinas antigas ser recusada: trocaria um
            problema em duas rotinas por um problema em oito. Regra é piso,
            não contrato do app. O app sempre grava o campo; a regra só
            impede valor inválido.
          */
          && (!("categoriaId" in request.resource.data)
              || textoCheio(request.resource.data.categoriaId, 60))
          && request.resource.data.duracaoMin is int
          && request.resource.data.duracaoMin >= 5
          && request.resource.data.duracaoMin <= 600
          && request.resource.data.ativa is bool
          && request.resource.data.diasSemana is list
          && request.resource.data.diasSemana.size() >= 1
          && request.resource.data.diasSemana.size() <= 7
          && request.resource.data.atividades is list
          // teto de atividades por rotina: um documento do Firestore não passa
          // de 1 MiB, e lista sem teto é o caminho pra bater nele em silêncio
          && request.resource.data.atividades.size() <= 30;
        allow delete: if dono(email);
      }

      match /tarefas/{id} {
        allow read: if dono(email);
        allow create, update: if dono(email)
          && request.resource.data.keys().hasOnly([
               'data','hora','duracaoMin','titulo','categoriaId','estado','origem',
               'rotinaId','rotinaAtividadeId','rotinaNome',
               'concluidaEm','descartadaEm',
               'agendaEventoId','agendaHash',
               'agendaAtrasoId','agendaAtrasoAte','createdAt'
             ])
          && dataISO(request.resource.data.data)
          && horaHM(request.resource.data.hora)
          && textoCheio(request.resource.data.titulo, 160)
          && texto(request.resource.data.categoriaId, 60)
          // mesmo vocabulário nos dois lados (crença 14): o app grava
          // exatamente estes três valores e mais nenhum
          && request.resource.data.estado in ['pendente','concluida','descartada']
          && request.resource.data.origem in ['rotina','manual'];
        allow delete: if dono(email);
      }

      match /config/perfil {
        allow read: if dono(email);
        /*
          TODO campo daqui é aceito ausente, e isso não é frouxidão — é o que
          faz uma gravação PARCIAL funcionar. Trocar a cor do app grava só
          `corTema` com merge; numa conta que nunca preencheu o perfil, o
          documento nasce nessa hora contendo esse único campo. Exigir `nome`
          presente recusava exatamente esse caso, e o sintoma era "não
          consigo mudar a cor" só pra quem ainda não tinha perfil — quem já
          tinha não via defeito nenhum (achado real, 2026-09-18).

          A regra é piso: impede valor inválido, não obriga o app a mandar o
          documento inteiro toda vez.
        */
        allow create, update: if dono(email)
          && request.resource.data.keys().hasOnly(['nome','telefone','nascimento','ocupacao','corTema'])
          && (!("nome" in request.resource.data) || texto(request.resource.data.nome, 120))
          && (!("telefone" in request.resource.data) || texto(request.resource.data.telefone, 20))
          && (!("ocupacao" in request.resource.data) || texto(request.resource.data.ocupacao, 80))
          && (!("nascimento" in request.resource.data) || texto(request.resource.data.nascimento, 10))
          && (!("corTema" in request.resource.data)
              || request.resource.data.corTema in
                 ['verde','ciano','azul','indigo','roxo','rosa','vermelho','ambar']);
        allow delete: if false;
      }

      match /config/estado {
        allow read: if dono(email);
        allow create, update: if dono(email)
          && request.resource.data.keys().hasOnly(['ultimaMaterializacao'])
          && dataISO(request.resource.data.ultimaMaterializacao);
        allow delete: if false;
      }

      // marca de que a migração de 2026-09-18 já rodou pra essa conta
      match /config/migracao {
        allow read: if dono(email);
        allow create, update: if dono(email)
          && request.resource.data.keys().hasOnly(['em'])
          && dataISO(request.resource.data.em);
        allow delete: if false;
      }
    }

    /* ─────────────── LEGADO — apagar depois que a migração rodar ───────────────
       Os dados de antes de 2026-09-18 moram em coleções na raiz. O app lê e
       apaga isso uma única vez, ao mover tudo pro espaço do dono. Só leitura
       e exclusão: nada novo é escrito aqui.  */

    function legadoDoDono() {
      return request.auth != null
        && request.auth.token.email.lower() == 'felipecastiged@gmail.com';
    }

    match /categorias/{id} { allow read, delete: if legadoDoDono(); }
    match /rotinas/{id}    { allow read, delete: if legadoDoDono(); }
    match /tarefas/{id}    { allow read, delete: if legadoDoDono(); }
    match /config/{id}     { allow read, delete: if legadoDoDono(); }

    // Nada fora do que está declarado acima.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
