/*
  firestore.rules — AppRotina

  Crença 1: autenticação nunca tem default. A resposta do Felipe em
  2026-09-17 foi login com Google E com e-mail/senha, os dois.

  AUTORIZAÇÃO POR E-MAIL, NÃO POR uid. Esse é o detalhe que evita uma
  armadilha real: se as regras fossem por uid, o login Google geraria um uid
  e o login por senha geraria outro, e ele veria duas listas de tarefas
  diferentes dependendo de como entrou. Autorizando por e-mail, os dois
  caminhos leem e escrevem o mesmo dado, e os documentos não precisam
  carregar dono.

  A lista abaixo tem que bater com EMAILS_AUTORIZADOS de firebase-init.js.
  Duas listas mantidas por mãos diferentes divergem em silêncio (crença 14 /
  antecipacao.md C1), então ao acrescentar um e-mail, acrescente nos dois.

  hasOnly() em toda coleção fecha mass assignment: sem ele, uma escrita
  poderia enfiar campo não previsto aqui.
*/

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null
        && request.auth.token.email in ['felipecastiged@gmail.com'];
    }

    function texto(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }
    function textoCheio(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }
    // "YYYY-MM-DD"
    function dataISO(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // "HH:MM"
    function horaHM(v) {
      return v is string && v.matches('^[0-9]{2}:[0-9]{2}$');
    }

    match /categorias/{id} {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.keys().hasOnly(['nome','cor','ordem','ativa','createdAt'])
        && textoCheio(request.resource.data.nome, 40)
        && texto(request.resource.data.cor, 9)
        && request.resource.data.ativa is bool;
      allow delete: if autorizado();
    }

    match /rotinas/{id} {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.keys().hasOnly([
             'nome','hora','duracaoMin','ativa','diasSemana','categoriaId','atividades',
             'agendaEventoId','agendaHash','createdAt'
           ])
        && textoCheio(request.resource.data.nome, 80)
        && horaHM(request.resource.data.hora)
        /*
          A rotina sempre tem categoria própria: sem atividade cadastrada,
          ela é a própria atividade (decisão de 2026-09-18).

          Mesmo assim o campo é ACEITO AUSENTE de propósito, porque rotina
          criada antes dessa decisão não o tem, e exigir aqui faria TODA
          gravação nessas rotinas antigas ser
          recusada: trocaria um problema em duas rotinas por um problema em
          oito. Regra é piso, não contrato do app. O app sempre grava o
          campo; a regra só impede valor inválido.
        */
        && (!("categoriaId" in request.resource.data)
            || textoCheio(request.resource.data.categoriaId, 60))
        && request.resource.data.duracaoMin is int
        && request.resource.data.duracaoMin >= 5
        && request.resource.data.duracaoMin <= 600
        && request.resource.data.ativa is bool
        && request.resource.data.diasSemana is list
        && request.resource.data.diasSemana.size() >= 1
        && request.resource.data.diasSemana.size() <= 7
        && request.resource.data.atividades is list
        // teto de atividades por rotina: um documento do Firestore não passa
        // de 1 MiB, e lista sem teto é o caminho pra bater nele em silêncio
        && request.resource.data.atividades.size() <= 30;
      allow delete: if autorizado();
    }

    match /tarefas/{id} {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.keys().hasOnly([
             'data','hora','duracaoMin','titulo','categoriaId','estado','origem',
             'rotinaId','rotinaAtividadeId','rotinaNome',
             'concluidaEm','descartadaEm',
             'agendaEventoId','agendaHash',
             'agendaAtrasoId','agendaAtrasoAte','createdAt'
           ])
        && dataISO(request.resource.data.data)
        && horaHM(request.resource.data.hora)
        && textoCheio(request.resource.data.titulo, 160)
        && texto(request.resource.data.categoriaId, 60)
        // mesmo vocabulário nos dois lados (crença 14): o app grava
        // exatamente estes três valores e mais nenhum
        && request.resource.data.estado in ['pendente','concluida','descartada']
        && request.resource.data.origem in ['rotina','manual'];
      allow delete: if autorizado();
    }

    match /config/perfil {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.keys().hasOnly(['nome','telefone','nascimento','ocupacao','corTema'])
        && texto(request.resource.data.nome, 120)
        && texto(request.resource.data.telefone, 20)
        && texto(request.resource.data.ocupacao, 80)
        // cor principal personalizável (2026-09-18): aceito ausente, senão
        // conta criada antes dessa data seria recusada ao salvar qualquer
        // outro dado do perfil — mesmo raciocínio do categoriaId da rotina.
        && (!("corTema" in request.resource.data)
            || request.resource.data.corTema in
               ['verde','ciano','azul','indigo','roxo','rosa','vermelho','ambar'])
        && (!("nascimento" in request.resource.data) || texto(request.resource.data.nascimento, 10));
      allow delete: if false;
    }

    match /config/estado {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.keys().hasOnly(['ultimaMaterializacao'])
        && dataISO(request.resource.data.ultimaMaterializacao);
      allow delete: if false;
    }

    // Nada fora do que está declarado acima.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
